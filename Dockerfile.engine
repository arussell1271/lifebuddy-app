FROM python:3.11-slim-bullseye AS builder

# Install build-time dependencies needed for packages like psycopg2
RUN apt-get update && apt-get install -y \
    gcc \
    python3-dev \
    build-essential \
    libpq-dev \
    --no-install-recommends && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

# Use the canonical engine requirements file
COPY ./engine/engine_requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy shared libs and engine code into the builder
COPY ./shared /usr/src/app/shared
COPY ./engine /usr/src/app/engine

# Final minimal runtime image
FROM python:3.11-slim-bullseye AS runner

RUN apt-get update && apt-get install -y \
    libpq5 \
    --no-install-recommends && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

# Copy installed Python packages and executables from the builder
COPY --from=builder /usr/local/lib/python3.11/site-packages/ /usr/local/lib/python3.11/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/

# Copy application code
COPY --from=builder /usr/src/app/shared /usr/src/app/shared
COPY --from=builder /usr/src/app/engine /usr/src/app/engine

CMD ["gunicorn", "engine.main:app", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", "-b", "0.0.0.0:8001"]
